# کلید امضای نسخه‌ی release.
# این فایل در .gitignore است و نباید در گیت برود.
#
# اگر android/keystore/nexus-hq.jks را دارید، این فایل را کپی کنید:
#   cp keystore.properties.example keystore.properties
# و مقادیر را با رمزهای خودتان پر کنید (همان‌هایی که موقع ساخت کلید زدید).
# اگر کلید را گم کرده‌اید، از تاریخچه‌ی گیت می‌توانید بازیابی کنید:
#   git show HEAD:android/keystore/nexus-hq.jks > android/keystore/nexus-hq.jks
# سپس با همین فایل رمزها را بازنشانی کنید (یا کلید جدید بسازید؛
# در این صورت به‌روزرسانی روی نسخه‌ی نصب‌شده‌ی قبلی ممکن نیست).
#
# به‌جای این فایل می‌توانید از متغیرهای محیطی هم استفاده کنید:
#   NEXUS_STORE_PASSWORD / NEXUS_KEY_PASSWORD / NEXUS_KEY_ALIAS
storePassword=CHANGE_ME
keyPassword=CHANGE_ME
keyAlias=nexushq
