{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nexus-hq-cloud",
  "main": "worker.js",
  "compatibility_date": "2026-08-27",
  "workers_dev": true,
  "durable_objects": {
    "bindings": [
      { "name": "NEXUS_CLOUD", "class_name": "NexusCloud" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["NexusCloud"] }
  ]
}
